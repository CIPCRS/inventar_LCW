// Reguli Firestore pentru colecțiile aplicației Inventar LCW (prefix lcw_).
// Se ADAUGĂ în regulile existente ale proiectului, în interiorul blocului
//   match /databases/{database}/documents { ... }
// fără să se atingă regulile celorlalte aplicații (Martur).

    match /lcw_inventare/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /lcw_config/{document} {
      allow read, write: if request.auth != null;
    }
    match /lcw_utilizatori/{document} {
      allow read, write: if request.auth != null;
    }
